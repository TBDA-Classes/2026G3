    {
      "cell_type": "code",
      "source": [
        "relation_df = env.merge(\n",
        "    loads,\n",
        "    on=[\"timestamp_local\", \"zone\"],\n",
        "    how=\"inner\"\n",
        ")\n",
        "\n",
        "print(\"Relation table shape:\", relation_df.shape)\n",
        "relation_df.head()\n",
        "drivers = [\n",
        "    \"temp_c\",\n",
        "    \"hum_pct\",\n",
        "    \"lum_lux\",\n",
        "    \"occupancy\"\n",
        "]\n",
        "\n",
        "load_types = [\n",
        "    \"HVAC\",\n",
        "    \"Lighting\",\n",
        "    \"Plugs & Sockets\",\n",
        "    \"Emerg. Lighting\",\n",
        "    \"Hand Dryer\",\n",
        "    \"RACK\"\n",
        "]\n",
        "\n",
        "results = []\n",
        "\n",
        "for zone in [\"NW\", \"SE\", \"SW\"]:\n",
        "\n",
        "    zone_data = relation_df[\n",
        "        relation_df[\"zone\"] == zone\n",
        "    ].copy()\n",
        "\n",
        "    for driver in drivers:\n",
        "\n",
        "        for load in load_types:\n",
        "\n",
        "            if load not in zone_data.columns:\n",
        "                continue\n",
        "\n",
        "            data = zone_data[[driver, load]].dropna()\n",
        "\n",
        "            if len(data) < 10:\n",
        "                continue\n",
        "\n",
        "            if data[driver].nunique() < 2:\n",
        "                continue\n",
        "\n",
        "            if data[load].nunique() < 2:\n",
        "                continue\n",
        "\n",
        "            pearson = data[driver].corr(\n",
        "                data[load],\n",
        "                method=\"pearson\"\n",
        "            )\n",
        "\n",
        "            spearman = data[driver].corr(\n",
        "                data[load],\n",
        "                method=\"spearman\"\n",
        "            )\n",
        "\n",
        "            results.append({\n",
        "                \"zone\": zone,\n",
        "                \"driver\": driver,\n",
        "                \"load_type\": load,\n",
        "                \"pearson\": pearson,\n",
        "                \"spearman\": spearman,\n",
        "                \"n\": len(data)\n",
        "            })\n",
        "\n",
