        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from scipy.stats import pearsonr, spearmanr\n",
        "from statsmodels.nonparametric.smoothers_lowess import lowess\n",
        "\n",
        "columns_needed = [\n",
        "    \"timestamp_local\",\n",
        "    \"zone\",\n",
        "    \"load_type\",\n",
        "    \"usable_for_model\",\n",
        "    \"power_w\",\n",
        "    \"temp_c\",\n",
        "    \"hum_pct\",\n",
        "    \"lum_lux\",\n",
        "    \"occupancy\"\n",
        "]\n",
        "\n",
        "df = pd.read_csv(\n",
        "    \"cedint_f1_hourly_clean (1).csv\",\n",
        "    usecols=columns_needed,\n",
        "    low_memory=False\n",
        ")\n",
        "\n",
        "df[\"timestamp_local\"] = pd.to_datetime(df[\"timestamp_local\"])\n",
        "\n",
        "df = df[df[\"usable_for_model\"] == 1].copy()\n",
        "\n",
        "df[\"hour\"] = df[\"timestamp_local\"].dt.hour\n",
        "\n",
        "print(\"Dataset shape:\", df.shape)\n",
        "\n",
        "print(\"\\nZones:\")\n",
        "print(df[\"zone\"].unique())\n",
        "\n",
        "print(\"\\nLoad types:\")\n",
        "print(df[\"load_type\"].unique())\n",
        "env = (\n",
        "    df[\n",
        "        [\n",
        "            \"timestamp_local\",\n",
        "            \"zone\",\n",
        "            \"temp_c\",\n",
        "            \"hum_pct\",\n",
        "            \"lum_lux\",\n",
        "            \"occupancy\"\n",
        "        ]\n",
        "    ]\n",
        "    .drop_duplicates([\"timestamp_local\", \"zone\"])\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "print(\"Environmental table shape:\", env.shape)\n",
        "env.head()\n",
        "loads = (\n",
        "    df.pivot_table(\n",
        "        index=[\"timestamp_local\", \"zone\"],\n",
        "        columns=\"load_type\",\n",
        "        values=\"power_w\",\n",
        "        aggfunc=\"mean\"\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "print(\"Loads table shape:\", loads.shape)\n",
        "loads.head()"
