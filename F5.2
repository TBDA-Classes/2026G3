    {
      "cell_type": "code",
      "source": [
        "import statsmodels.api as sm\n",
        "\n",
        "partial_results = []\n",
        "\n",
        "for zone in [\"NW\", \"SE\", \"SW\"]:\n",
        "\n",
        "    zone_data = relation_df[\n",
        "        relation_df[\"zone\"] == zone\n",
        "    ].copy()\n",
        "\n",
        "    zone_data[\"hour\"] = zone_data[\"timestamp_local\"].dt.hour\n",
        "\n",
        "    for driver in drivers:\n",
        "\n",
        "        for load in load_types:\n",
        "\n",
        "            if load not in zone_data.columns:\n",
        "                continue\n",
        "\n",
        "            data = zone_data[\n",
        "                [driver, load, \"hour\"]\n",
        "            ].dropna()\n",
        "\n",
        "            if len(data) < 10:\n",
        "                continue\n",
        "\n",
        "            if data[driver].nunique() < 2:\n",
        "                continue\n",
        "\n",
        "            if data[load].nunique() < 2:\n",
        "                continue\n",
        "\n",
        "            # Hour treated as categorical\n",
        "            hour_dummies = pd.get_dummies(\n",
        "                data[\"hour\"],\n",
        "                prefix=\"hour\",\n",
        "                drop_first=True,\n",
        "                dtype=float\n",
        "            )\n",
        "\n",
        "            X = sm.add_constant(hour_dummies)\n",
        "\n",
        "            # Remove the effect of hour from the environmental driver\n",
        "            driver_resid = sm.OLS(\n",
        "                data[driver].astype(float),\n",
        "                X\n",
        "            ).fit().resid\n",
        "\n",
        "            # Remove the effect of hour from the load\n",
        "            load_resid = sm.OLS(\n",
        "                data[load].astype(float),\n",
        "                X\n",
        "            ).fit().resid\n",
        "\n",
        "            partial_corr = driver_resid.corr(load_resid)\n",
        "\n",
        "            partial_results.append({\n",
        "                \"zone\": zone,\n",
        "                \"driver\": driver,\n",
        "                \"load_type\": load,\n",
        "                \"partial_corr_hour\": partial_corr,\n",
        "                \"n\": len(data)\n",
        "            })\n",
        "\n",
        "partial_correlation_results = pd.DataFrame(partial_results)\n",
        "\n",
        "partial_correlation_results"
      ],
