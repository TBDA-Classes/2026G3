    {
      "cell_type": "code",
      "source": [
        "def plot_relation(zone, driver, load, max_points=3000):\n",
        "\n",
        "    data = relation_df[\n",
        "        relation_df[\"zone\"] == zone\n",
        "    ][[driver, load]].dropna()\n",
        "\n",
        "    if len(data) == 0:\n",
        "        print(\"No data available\")\n",
        "        return\n",
        "\n",
        "    # Sample only for visualization, correlations already use all observations\n",
        "    if len(data) > max_points:\n",
        "        plot_data = data.sample(\n",
        "            n=max_points,\n",
        "            random_state=42\n",
        "        )\n",
        "    else:\n",
        "        plot_data = data.copy()\n",
        "\n",
        "    plot_data = plot_data.sort_values(driver)\n",
        "\n",
        "    plt.figure(figsize=(9, 5))\n",
        "\n",
        "    plt.scatter(\n",
        "        plot_data[driver],\n",
        "        plot_data[load],\n",
        "        alpha=0.15,\n",
        "        s=12\n",
        "    )\n",
        "\n",
        "    lowess_line = lowess(\n",
        "        plot_data[load],\n",
        "        plot_data[driver],\n",
        "        frac=0.20,\n",
        "        return_sorted=True\n",
        "    )\n",
        "\n",
        "    plt.plot(\n",
        "        lowess_line[:, 0],\n",
        "        lowess_line[:, 1],\n",
        "        linewidth=2\n",
        "    )\n",
        "\n",
        "    plt.xlabel(driver)\n",
        "    plt.ylabel(f\"{load} Power (W)\")\n",
        "    plt.title(f\"{zone}: {driver} vs {load} - LOWESS\")\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# FIRST TEST: NW Temperature vs HVAC\n",
        "plot_relation(\"NW\", \"temp_c\", \"HVAC\")\n",
        "plot_relation(\"NW\", \"lum_lux\", \"Lighting\")\n",
